# Local tooling and credentials
.agents/
.env
.env.*
!.env.example
*.pem
*.key
*credentials*
*secret*

# Python environments and caches
.venv/
venv/
venvs/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Generated/fetched data and results - reproducible from the pipeline, not
# hand-authored, so they don't belong in git. Keep raw query inputs tracked
# (data/raw/) since those define the experiment.
data/processed/
data/external/
results/hits/
results/msa/
results/tree/
results/metrics/
results/structures/

# logs/<tool>/ subdirectories are tracked (via .gitkeep) even though their
# contents aren't: Slurm's #SBATCH --output=logs/<tool>/%x-%j.out needs the
# directory to already exist BEFORE the job starts - it's resolved by Slurm
# itself prior to the script running, so a script's own `mkdir -p` can't
# help. Without this, a job's real output can still complete fine while its
# log silently fails to write, because that's a separate, unrelated
# mkdir inside the script that runs too late to matter for Slurm's own
# output-file handling.
logs/*
logs/*/*
!logs/*/
!logs/*/.gitkeep

# Large reference databases if ever staged locally/on scratch
*.fasta.gz
uniref*.fasta
uniprot_*.fasta

# Scheduler/runtime artifacts (in case any land outside logs/)
*.out
*.err
*.bak
*.tmp
*.swp
